# Variables de entorno de Voltia.
# Solo existen variables PUBLIC_*: se leen en build (astro build) y acaban en el bundle del cliente.
# NUNCA poner secretos aquí ni en ninguna PUBLIC_*. No hay claves privadas en el MVP.
# Copiar a .env para desarrollo local (.env está en .gitignore).
# En Cloudflare Pages se definen en Settings → Environment variables (Production y Preview)
# y requieren relanzar el build para aplicarse.

# URL canónica del sitio (sin barra final). Usada por `site` en astro.config.mjs: canonicals, sitemap, JSON-LD, OG.
PUBLIC_SITE_URL=http://localhost:4321

# Número de WhatsApp de ventas en formato internacional SIN "+" (8–15 dígitos). Ej. España: 34612345678.
# En local y preview usar un número de pruebas; el real solo en el entorno Production del hosting.
PUBLIC_WHATSAPP_NUMBER=34600000000

# Email de contacto mostrado en el pie y en JSON-LD de Organization.
PUBLIC_CONTACT_EMAIL=hola@voltia.example.com

# Adaptador de analítica: "console" (dev), "datalayer" (window.dataLayer) o vacío (noop). Sin cookies, sin PII.
PUBLIC_ANALYTICS=console

# Token del beacon de Cloudflare Web Analytics (cookieless). Vacío = no se carga el script.
# No es un secreto (es público por diseño), pero solo debe definirse en Production.
PUBLIC_CF_BEACON_TOKEN=
