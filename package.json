{
  "name": "motos-electricas",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/validate-content.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/check-csp.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "astro check && npm run check:functions",
    "perf:budget": "node scripts/check-budgets.mjs",
    "perf:lhci": "npx --yes @lhci/cli@0.16.0 autorun --config=.lighthouserc.json",
    "validate:content": "node scripts/validate-content.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:functions": "tsc -p functions/tsconfig.json",
    "admin:dev": "wrangler pages dev dist --port 8788 --compatibility-date=2026-10-01 --kv ADMIN_KV",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/preact": "^1.1.0",
    "astro": "^7.4.2",
    "nanostores": "^1.5.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
