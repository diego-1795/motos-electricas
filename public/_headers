# Cabeceras HTTP para Cloudflare Pages / Netlify (mismo formato).
# Equivalente para Vercel en /vercel.json. Ver docs/10-security.md y docs/13-cloudflare.md.
#
# CSP: sin 'unsafe-inline' en script-src. Los módulos grandes van a /_astro/ ('self'), pero Astro inlina
# el runtime de islas (astro-island, client:load/idle/visible) y los <script> pequeños de componentes
# (Header, SearchModal, ProductTabs, CatalogView, HeroSlider, ClientGallery). Esos 10 scripts inline (4 del runtime + 6 de
# componentes) se autorizan por hash sha256.
# Los hashes del runtime cambian al actualizar Astro; los de componentes, al editar su <script>.
# CI (ci.yml, job build, paso "CSP: hashes de scripts inline") comprueba que todo script inline de dist/
# tiene su hash aquí y, si falta alguno, imprime los hashes a añadir (también en vercel.json).
# Los <script type="application/ld+json"> son datos, no se ejecutan y no necesitan hash.
# style-src necesita 'unsafe-inline' por los estilos scoped de Astro (inlineStylesheets: 'auto') e islas Preact.
# Los orígenes cloudflareinsights solo se usan si PUBLIC_CF_BEACON_TOKEN está definido; son inofensivos si no.
# 'wasm-unsafe-eval': el buscador Pagefind (/pagefind/*.wasm) compila WebAssembly en el navegador.
# frame-src youtube-nocookie: facade de vídeo de la ficha de producto (el iframe solo se crea al pulsar reproducir).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' 'sha256-yE4QJ+6KezhWIeDWDuFf5qAiOcfnKFMQ1h/rx7Lm+xY=' 'sha256-iUuRMueTYxJx1jukA6AcOs+hjXeqBG8dbPvD9T1D/d4=' 'sha256-lw1proxdDijaTAnZU7JW1/iJ0QCq+B3ln/iVRy08IpQ=' 'sha256-AXQNpXnH2KwiQVBqx3cFz96ATQzvgp7nMYDiXrCI+w0=' 'sha256-kSSKTJg+uZ3PSJdH/hkrlEw+WsUKXtj97Hfig2llIVo=' 'sha256-WhHiABsluR561tPLuJu2uae34qj7i1PyDZBDCOoX3ew=' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# Panel de administración (ADR-018): tras Cloudflare Access. Política propia: sin insights ni YouTube,
# connect-src solo al propio origen (/api/admin/*), nunca en caché ni indexado. "! Cabecera" retira la
# versión global antes de redefinirla. Solo lleva los 4 hashes del runtime de islas (el panel no usa scripts de componentes).
/admin
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# API del panel. Nota: _headers solo se aplica a ficheros estáticos; las respuestas de las Pages Functions
# (functions/api/admin) ponen Cache-Control: no-store desde su propio middleware. Este bloque cubre el caso
# de que la ruta se sirviera estáticamente (p. ej. un hosting sin Functions).
/api/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Activos con hash en el nombre: caché inmutable de un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Sitemaps: caché corta para que los cambios de catálogo se reflejen pronto.
/sitemap*.xml
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.*
  Cache-Control: public, max-age=604800

/og-default.png
  Cache-Control: public, max-age=604800
