---
import type { Product, CategorySlug, VariantTier } from '../../domain/types';
import { TYPES, sortLabels, type SortKey } from '../../domain/catalog';
import { fromPrice, maxRange, productAvailability, tierLabel } from '../../domain/product';
import ProductCard from '../product/ProductCard.astro';

/**
 * Vista de catálogo con filtros progresivos adaptados al catálogo real (ADR-015):
 * - HTML completo de todos los productos (SEO, sin JS funciona como listado).
 * - Un script ligero filtra/ordena en cliente leyendo data-* y sincroniza la URL.
 * Filtros: precio, categoría, etiqueta (Estándar/Premium), modelo y disponibilidad.
 */
interface Props {
  products: Product[];
  /** Si se fija, oculta el filtro de categoría */
  lockedType?: CategorySlug;
  categoryNames: Record<string, string>;
}
const { products, lockedType, categoryNames } = Astro.props;
const sortKeys: SortKey[] = ['recomendados', 'precio-asc', 'precio-desc', 'novedades', 'autonomia'];
const TIERS: VariantTier[] = ['estandar', 'premium'];
const maxPrice = Math.max(500, Math.ceil(Math.max(...products.map((p) => fromPrice(p).amount)) / 100 / 100) * 100);
const minPrice = 500;
const models = [...products].sort((a, b) => a.name.localeCompare(b.name, 'es'));
const tiersOf = (p: Product) => TIERS.filter((t) => p.variants.some((v) => v.tier === t));
---

<div class="catalog" data-catalog>
  <form class="filters" data-filters aria-label="Filtros del catálogo">
    <button type="button" class="filters__summary" aria-expanded="false" aria-controls="filters-body" data-filters-toggle>
      <span>Filtros</span>
      <span class="filters__count muted" data-count>{products.length} modelos</span>
    </button>
    <div class="filters__body" id="filters-body">
      {
        !lockedType && (
          <div class="field">
            <label class="label" for="f-tipo">Categoría</label>
            <select id="f-tipo" name="tipo" class="select">
              <option value="">Todas</option>
              {TYPES.map((t) => (
                <option value={t}>{categoryNames[t] ?? t}</option>
              ))}
            </select>
          </div>
        )
      }
      <div class="field">
        <label class="label" for="f-precio">Precio máximo: <output for="f-precio" data-out="precio">S/ {maxPrice}</output></label>
        <input id="f-precio" name="precio" type="range" min={minPrice} max={maxPrice} step="100" value={maxPrice} />
      </div>
      <fieldset class="field filters__group">
        <legend class="label">Etiqueta</legend>
        <div class="filters__choices">
          {
            TIERS.map((t) => (
              <label class="choice">
                <input type="checkbox" name="etiqueta" value={t} />
                {tierLabel[t]}
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="field filters__group">
        <legend class="label">Modelo</legend>
        <div class="filters__checks">
          {
            models.map((p) => (
              <label class="filters__check">
                <input type="checkbox" name="modelo" value={p.slug} />
                <span>{p.name}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field">
        <label class="label" for="f-disp">Disponibilidad</label>
        <select id="f-disp" name="disponibilidad" class="select">
          <option value="">Cualquiera</option>
          <option value="en-stock">En stock</option>
          <option value="bajo-pedido">Bajo pedido</option>
          <option value="proximamente">Próximamente</option>
        </select>
      </div>
      <button type="reset" class="btn btn--ghost btn--sm">Limpiar filtros</button>
    </div>
  </form>

  <div class="results">
    <div class="results__bar">
      <p class="muted" aria-live="polite" data-results-text>
        1 – <span data-count-inline>{products.length}</span> de {products.length} resultados
      </p>
      <label class="results__sort">
        <span class="visually-hidden">Ordenar por</span>
        <select name="orden" class="select" data-sort form="">
          {sortKeys.map((k) => <option value={k}>{sortLabels[k]}</option>)}
        </select>
      </label>
    </div>

    <ul role="list" class="grid-products" data-grid>
      {
        products.map((p, i) => (
          <li
            data-item
            data-slug={p.slug}
            data-tipo={p.category}
            data-precio={fromPrice(p).amount / 100}
            data-autonomia={maxRange(p)}
            data-tiers={tiersOf(p).join(' ')}
            data-disponibilidad={productAvailability(p)}
            data-featured={p.featured}
            data-fecha={p.publishedAt}
          >
            <ProductCard product={p} priority={i === 0} headingLevel="h2" categoryLabel={categoryNames[p.category]} />
          </li>
        ))
      }
    </ul>
    <p class="results__empty" data-empty hidden>
      No hay modelos con esos filtros. <button type="button" class="btn btn--secondary btn--sm" data-reset>Quitar filtros</button>
    </p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-filters]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-item]'));
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const countBadge = root.querySelector<HTMLElement>('[data-count]');
    const resultsText = root.querySelector<HTMLElement>('[data-results-text]');
    const total = items.length;

    const num = (el: HTMLElement, k: string) => Number(el.dataset[k] ?? 0);

    function read() {
      const fd = new FormData(form);
      const get = (k: string) => String(fd.get(k) ?? '');
      return {
        tipo: get('tipo'),
        precio: Number(get('precio') || Infinity),
        etiquetas: fd.getAll('etiqueta').map(String),
        modelos: fd.getAll('modelo').map(String),
        disponibilidad: get('disponibilidad'),
        orden: sort.value,
      };
    }

    function apply() {
      const f = read();
      let visible = 0;
      for (const el of items) {
        const tiers = (el.dataset.tiers ?? '').split(' ');
        const ok =
          (!f.tipo || el.dataset.tipo === f.tipo) &&
          num(el, 'precio') <= f.precio &&
          (f.etiquetas.length === 0 || f.etiquetas.some((t) => tiers.includes(t))) &&
          (f.modelos.length === 0 || f.modelos.includes(el.dataset.slug ?? '')) &&
          (!f.disponibilidad || el.dataset.disponibilidad === f.disponibilidad);
        el.hidden = !ok;
        if (ok) visible++;
      }
      const sorted = [...items].sort((a, b) => {
        switch (f.orden) {
          case 'precio-asc':
            return num(a, 'precio') - num(b, 'precio');
          case 'precio-desc':
            return num(b, 'precio') - num(a, 'precio');
          case 'autonomia':
            return num(b, 'autonomia') - num(a, 'autonomia');
          case 'novedades':
            return (b.dataset.fecha ?? '').localeCompare(a.dataset.fecha ?? '');
          default:
            return num(b, 'featured') - num(a, 'featured');
        }
      });
      const current = Array.from(grid.children);
      if (sorted.some((el, i) => el !== current[i])) sorted.forEach((el) => grid.appendChild(el));
      empty.hidden = visible > 0;
      if (countBadge) countBadge.textContent = `${visible} ${visible === 1 ? 'modelo' : 'modelos'}`;
      if (resultsText) {
        resultsText.innerHTML = visible
          ? `1 – <span data-count-inline>${visible}</span> de ${total} resultados`
          : `<span data-count-inline>0</span> de ${total} resultados`;
      }

      // Output del rango de precio
      const out = form.querySelector<HTMLOutputElement>('[data-out="precio"]');
      const price = form.elements.namedItem('precio') as HTMLInputElement | null;
      if (out && price) out.textContent = `S/ ${price.value}`;

      // URL compartible (sin recargar)
      const params = new URLSearchParams();
      for (const el of Array.from(form.elements) as HTMLInputElement[]) {
        if (!el.name || el.type === 'reset' || el.type === 'button') continue;
        if (el.type === 'checkbox') {
          if (el.checked) params.append(el.name, el.value);
          continue;
        }
        const def = el.type === 'range' ? el.max : '';
        if (el.value !== def && el.value !== '') params.set(el.name, el.value);
      }
      if (sort.value !== 'recomendados') params.set('orden', sort.value);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    // Restaurar desde URL
    const initial = new URLSearchParams(location.search);
    for (const [k, v] of initial.entries()) {
      if (k === 'orden') {
        sort.value = v;
        continue;
      }
      const field = form.elements.namedItem(k);
      if (!field) continue;
      if (field instanceof RadioNodeList || (field instanceof HTMLInputElement && field.type === 'checkbox')) {
        const boxes = field instanceof RadioNodeList ? (Array.from(field) as HTMLInputElement[]) : [field];
        boxes.forEach((b) => {
          if (b.value === v) b.checked = true;
        });
      } else {
        (field as HTMLInputElement).value = v;
      }
    }

    form.addEventListener('input', apply);
    form.addEventListener('reset', () => requestAnimationFrame(apply));
    sort.addEventListener('change', apply);
    root.querySelector('[data-reset]')?.addEventListener('click', () => form.reset());
    const toggle = form.querySelector<HTMLButtonElement>('[data-filters-toggle]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      form.classList.toggle('is-open', !open);
    });

    apply();
  }
</script>

<style>
  .catalog {
    display: grid;
    gap: var(--s-6);
  }
  .filters__summary {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-elev);
    font-weight: 600;
    cursor: pointer;
  }
  .filters.is-open .filters__summary {
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  .filters__body {
    display: none;
  }
  .filters.is-open .filters__body {
    display: grid;
  }
  .filters__body {
    gap: var(--s-5);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    background: var(--bg-elev);
  }
  .filters__group {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .filters__group legend {
    padding: 0;
    margin-bottom: var(--s-2);
  }
  .filters__choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .filters__checks {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .filters__check {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    cursor: pointer;
    min-height: 1.75rem;
  }
  .filters__check input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--accent);
    margin: 0;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
  .results__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .results__bar p {
    font-size: var(--fs-sm);
  }
  .results__sort .select {
    min-width: 12rem;
  }
  .results__empty[hidden] {
    display: none;
  }
  .results__empty {
    margin-top: var(--s-6);
    display: flex;
    gap: var(--s-3);
    align-items: center;
    flex-wrap: wrap;
  }
  @media (min-width: 1024px) {
    .catalog {
      grid-template-columns: 17rem 1fr;
      gap: var(--s-10);
      align-items: start;
    }
    .filters {
      position: sticky;
      top: 4.75rem;
    }
    .filters__summary {
      pointer-events: none;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
    }
    .filters__body {
      display: grid;
    }
  }
</style>
