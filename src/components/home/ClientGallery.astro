---
import Pic from '../ui/Pic.astro';
import type { ImageRef } from '../../domain/types';

/**
 * Galería de clientes: una foto cada vez, con flechas "< foto >" y contador.
 * Progresiva: la pista es un scroll horizontal con scroll-snap (funciona sin JS
 * y con swipe); el script sincroniza flechas, contador y teclado (← →).
 */
interface Props {
  images: ImageRef[];
  label?: string;
}
const { images, label = 'Fotos de clientes RAIDEN' } = Astro.props;
---

<div class="cg" data-gallery aria-roledescription="carrusel" aria-label={label}>
  <ul role="list" class="cg__track" data-gallery-track tabindex="0">
    {
      images.map((img, i) => (
        <li class="cg__slide" data-gallery-slide aria-roledescription="diapositiva" aria-label={`Foto ${i + 1} de ${images.length}`}>
          <Pic image={img} width={720} height={960} widths={[480, 720, 960]} sizes="(min-width: 1024px) 36rem, 92vw" />
        </li>
      ))
    }
  </ul>
  <button type="button" class="cg__arrow cg__arrow--prev" aria-label="Foto anterior" data-gallery-prev>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" />
    </svg>
  </button>
  <button type="button" class="cg__arrow cg__arrow--next" aria-label="Foto siguiente" data-gallery-next>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 5l7 7-7 7" />
    </svg>
  </button>
  <p class="cg__counter muted" aria-live="polite">
    <span data-current>1</span> / {images.length}
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-gallery-track]')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const current = root.querySelector<HTMLElement>('[data-current]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    if (slides.length < 2) return;
    let index = 0;
    let programmatic: ReturnType<typeof setTimeout> | undefined;

    function paint() {
      if (current) current.textContent = String(index + 1);
      slides.forEach((s, i) => s.setAttribute('aria-current', i === index ? 'true' : 'false'));
    }
    function go(i: number) {
      index = (i + slides.length) % slides.length;
      clearTimeout(programmatic);
      programmatic = setTimeout(() => (programmatic = undefined), 800);
      track.scrollTo({ left: slides[index]!.offsetLeft, behavior: reduce.matches ? 'auto' : 'smooth' });
      paint();
    }
    track.addEventListener('scrollend', () => {
      clearTimeout(programmatic);
      programmatic = undefined;
    });
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          if (programmatic) return;
          const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
          if (i !== index) {
            index = Math.min(slides.length - 1, Math.max(0, i));
            paint();
          }
        });
      },
      { passive: true },
    );
    root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-gallery-next]')?.addEventListener('click', () => go(index + 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });
    paint();
  });
</script>

<style>
  .cg {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
  }
  .cg__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    border-radius: var(--r-xl);
  }
  .cg__track::-webkit-scrollbar {
    display: none;
  }
  .cg__track:focus-visible {
    outline: 2px solid var(--accent-text, var(--accent));
    outline-offset: 4px;
  }
  .cg__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: grid;
    place-items: center;
    background: var(--bg-elev, #1a1a1a);
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .cg__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cg__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-full);
    border: 1px solid var(--n-700);
    background: rgb(17 17 17 / 0.65);
    color: var(--dark-fg, #fff);
    display: grid;
    place-items: center;
    backdrop-filter: blur(4px);
    transition:
      background var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .cg__arrow:hover,
  .cg__arrow:focus-visible {
    border-color: var(--n-400);
    background: rgb(17 17 17 / 0.85);
  }
  .cg__arrow--prev {
    left: var(--s-3);
  }
  .cg__arrow--next {
    right: var(--s-3);
  }
  .cg__counter {
    text-align: center;
    margin-top: var(--s-4);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1024px) {
    .cg {
      max-width: 36rem;
    }
    .cg__arrow--prev {
      left: calc(var(--s-6) * -1 - 2.75rem);
    }
    .cg__arrow--next {
      right: calc(var(--s-6) * -1 - 2.75rem);
    }
  }
</style>
