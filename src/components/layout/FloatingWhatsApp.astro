---
import WhatsAppLink from '../ui/WhatsAppLink.astro';

/**
 * Botón flotante de WhatsApp, solo icono, visible en móvil y escritorio
 * (decisión del cliente, 2026-10-23). Nombre accesible vía texto oculto.
 * Se coloca a la derecha para no tapar el toast (centrado).
 */
---

<div class="fab" data-pagefind-ignore>
  <WhatsAppLink source="floating" class="btn btn--whatsapp fab__btn">
    <span class="visually-hidden">Hablar por WhatsApp</span>
  </WhatsAppLink>
</div>

<style>
  .fab {
    position: fixed;
    right: var(--s-4);
    bottom: calc(var(--s-4) + env(safe-area-inset-bottom));
    z-index: var(--z-header);
  }
  .fab__btn {
    width: 3.5rem;
    height: 3.5rem;
    min-height: 0;
    padding: 0;
    border-radius: var(--r-full);
    box-shadow: var(--sh-3);
  }
  .fab__btn :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }
  @media (min-width: 1024px) {
    .fab {
      right: var(--s-6);
      bottom: var(--s-6);
    }
  }
</style>
