---
import { site } from '../../config/site';
import Logo from '../ui/Logo.astro';
import Pic from '../ui/Pic.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import { repos } from '../../data';
import { COMPARE_PATH, FINDER_PATH } from '../../lib/routes';

/**
 * Pie de página (brief del cliente): fondo oscuro con imagen + overlay,
 * oficina principal, categorías, ayuda, métodos de pago y redes, razón social y legales.
 * Todos los datos salen de src/config/site.ts.
 */
const categories = await repos.categories.all();
const year = new Date().getFullYear();
const bg = { src: '~/assets/brand/footer-bg.png', alt: '', width: 2172, height: 724 };

const socials = [
  {
    name: 'Instagram',
    url: site.social.instagram,
    path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM17.5 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z',
  },
  {
    name: 'Facebook',
    url: site.social.facebook,
    path: 'M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3z',
  },
  {
    name: 'TikTok',
    url: site.social.tiktok,
    path: 'M16.6 2c.3 2.3 1.6 3.7 3.9 3.9v3.3c-1.4.1-2.6-.3-3.9-1.1v7.2c0 9.2-10 12.1-14 5.5-2.6-4.3-1-11.8 7.2-12.1v3.5c-.6.1-1.3.3-1.9.5-1.8.6-2.9 1.8-2.6 3.8.6 3.9 7.7 5.1 7.1-2.6V2h4.2z',
  },
].filter((s) => s.url);
---

<footer class="footer surface-dark" data-pagefind-ignore>
  <div class="footer__bg" aria-hidden="true">
    <Pic image={bg} alt="" width={1600} height={530} widths={[800, 1200, 1600]} sizes="100vw" />
  </div>

  <div class="container footer__grid">
    <section class="footer__col" aria-labelledby="f-office">
      <h2 id="f-office" class="eyebrow">Oficina principal</h2>
      <address class="footer__address">
        <p>{site.address}</p>
        <p><a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps →</a></p>
        <p><a href={`tel:+${site.whatsappNumber}`}>{site.phoneDisplay}</a></p>
        <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
        <p class="muted footer__hours">{site.hours}</p>
      </address>
    </section>

    <nav class="footer__col" aria-labelledby="f-cat">
      <h2 id="f-cat" class="eyebrow">Categorías</h2>
      <ul role="list">
        {categories.map((c) => <li><a href={`/${c.slug}`}>{c.name}</a></li>)}
        <li><a href="/productos">Todos los productos</a></li>
      </ul>
    </nav>

    <nav class="footer__col" aria-labelledby="f-help">
      <h2 id="f-help" class="eyebrow">Ayuda</h2>
      <ul role="list">
        <li><a href={FINDER_PATH}>Encuentra tu bicimoto</a></li>
        <li><a href={COMPARE_PATH}>Comparar modelos</a></li>
        <li><a href="/servicio-tecnico">Servicio técnico</a></li>
        <li><a href="/garantia">Garantía</a></li>
        <li><a href="/faq">Preguntas frecuentes</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </nav>

    <section class="footer__col" aria-labelledby="f-pay">
      <h2 id="f-pay" class="eyebrow">Métodos de pago y redes sociales</h2>
      <p class="footer__pay">Visa · Mastercard · American Express <span class="muted">(en tienda, coordinado con tu asesor)</span></p>
      <ul role="list" class="footer__social" aria-label="Redes sociales">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
        <li>
          <WhatsAppLink source="footer" class="footer__wa">
            <span class="visually-hidden">WhatsApp</span>
          </WhatsAppLink>
        </li>
      </ul>
    </section>
  </div>

  <div class="container footer__bottom">
    <div class="footer__brand">
      <Logo invert />
      <p class="footer__legalname">
        {site.legalName} · RUC {site.ruc} · Distribuidor oficial de {site.name.toUpperCase()}
      </p>
    </div>
    <ul role="list" class="footer__legal">
      <li><a href="/legal/aviso-legal">Términos y condiciones</a></li>
      <li><a href="/legal/privacidad">Privacidad</a></li>
      <li><a href="/legal/cookies">Cookies</a></li>
    </ul>
    <small class="muted footer__copy">
      © {year} {site.legalName}. Precios en soles (S/) con IGV. Las solicitudes de compra se gestionan por WhatsApp; no se realizan pagos en esta web.
    </small>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    margin-top: var(--section);
    padding-block: var(--s-16) var(--s-8);
    overflow: hidden;
  }
  .footer__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .footer__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.35;
  }
  .footer__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--dark-bg) 78%, transparent), color-mix(in srgb, var(--dark-bg) 96%, transparent));
  }
  .footer__grid {
    display: grid;
    gap: var(--s-10);
    grid-template-columns: 1fr;
  }
  .footer__col ul,
  .footer__address {
    margin-top: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .footer__address {
    font-style: normal;
  }
  .footer__address p,
  .footer__col a {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .footer__col a:hover {
    color: var(--fg);
  }
  .footer__address a {
    color: var(--fg);
  }
  .footer__hours {
    font-size: var(--fs-xs);
  }
  .footer__pay {
    margin-top: var(--s-4);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .footer__pay .muted {
    font-weight: 400;
  }
  .footer__social {
    flex-direction: row !important;
    flex-wrap: wrap;
    gap: var(--s-3) !important;
    margin-top: var(--s-5) !important;
  }
  .footer__social a,
  .footer__social :global(.footer__wa) {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-full);
    border: 1px solid var(--border-strong);
    color: var(--fg);
    transition:
      color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease),
      background var(--t-fast) var(--ease);
  }
  .footer__social a:hover,
  .footer__social :global(.footer__wa:hover) {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    text-decoration: none;
  }
  .footer__social :global(.footer__wa:hover) {
    color: #25d366;
    border-color: #25d366;
    background: rgb(37 211 102 / 0.12);
  }
  .footer__social :global(.footer__wa svg) {
    width: 22px;
    height: 22px;
  }
  .footer__bottom {
    margin-top: var(--s-12);
    padding-top: var(--s-6);
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .footer__legalname {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
  .footer__legal a {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .footer__legal a:hover {
    color: var(--fg);
  }
  .footer__copy {
    font-size: var(--fs-xs);
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.3fr 0.8fr 0.9fr 1.3fr;
    }
    .footer__bottom {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    .footer__brand {
      flex-direction: row;
      align-items: center;
      gap: var(--s-5);
    }
    .footer__copy {
      flex-basis: 100%;
    }
  }
</style>
