---
import type { Specs } from '../../domain/types';
import { specTilesFor, type SpecRow } from '../../domain/specTable';

/**
 * Tiles de la ficha técnica. Con `rows` (de specTiles(p)) cada tile puede
 * traer un valor por versión (Estándar/Premium): se renderizan todos y la isla
 * ProductConfigurator deja visible solo el de la versión elegida. Sin JS se ven
 * todos, cada uno con su etiqueta de versión.
 * Con `specs` (sin versiones, p. ej. el styleguide) se calculan valores únicos.
 */
interface Props {
  rows?: SpecRow[];
  specs?: Specs;
  compact?: boolean;
}
const { rows, specs, compact = false } = Astro.props;
const tiles = rows ?? (specs ? specTilesFor(specs, compact) : []);
---

<dl class="spec-grid">
  {
    tiles.map((t) => (
      <div class="spec-tile">
        <dt class="spec-tile__label">{t.label}</dt>
        {t.value !== undefined ? (
          <dd class="spec-tile__value">{t.value}</dd>
        ) : (
          t.byVariant!.map((v) => (
            <dd class="spec-tile__value spec-variant" data-spec-variant={v.id}>
              {v.value} <span class="spec-variant__tier">{v.label}</span>
            </dd>
          ))
        )}
      </div>
    ))
  }
</dl>
