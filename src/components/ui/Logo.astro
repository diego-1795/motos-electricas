---
import { site } from '../../config/site';
interface Props {
  class?: string;
}
---

<span class:list={['logo', Astro.props.class]}>
  <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
    <rect width="26" height="26" rx="7" fill="currentColor" />
    <path d="M8 5l4 9h2.5L18 5h-2.6l-2.9 6.4L9.6 5zM9 21l1.5-5h5L17 21z" fill="var(--volt)" />
  </svg>
  <span class="logo__name">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: 1.125rem;
  }
</style>
