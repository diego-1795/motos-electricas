---
import { site } from '../../config/site';
interface Props {
  class?: string;
}
---

<span class:list={['logo', Astro.props.class]}>
  <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
    <rect width="26" height="26" rx="7" fill="currentColor" />
    <path d="M14.5 3.5 6.5 14.5h5.5L10.5 22.5l9-12h-5.5z" fill="var(--volt)" />
  </svg>
  <span class="logo__name">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: 1.125rem;
  }
</style>
