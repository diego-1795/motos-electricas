---
/**
 * Logo Raiden (docs/02-design-system.md §5).
 * Renderiza el logotipo real del cliente (PNG transparente) vía astro:assets.
 *
 * - variant 'full'     → marca + wordmark + tagline (por defecto; ratio 5.25:1)
 * - variant 'wordmark' → marca + RAIDEN sin tagline (misma altura, más legible en cabeceras pequeñas)
 * - variant 'mark'     → solo el rayo (ratio 1.14:1), p. ej. móvil o avatares
 * - invert             → blanco sobre fondos oscuros: filter brightness(0) invert(1) sobre el webp con alfa.
 *                        Solo el pie de página lo usa (excepción al logo azul aceptada por el cliente, 2026-11-04);
 *                        cabecera y resto del sitio van en azul sobre claro.
 * - height             → altura en px (28–32 en header; 40–48 en footer)
 */
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import logoFull from '../../assets/brand/logo-trim.webp';
import logoWordmark from '../../assets/brand/logo-wordmark.webp';
import logoMark from '../../assets/brand/logo-mark.webp';

interface Props {
  class?: string;
  variant?: 'full' | 'wordmark' | 'mark';
  invert?: boolean;
  height?: number;
}

const { variant = 'full', invert = false, height = 32 } = Astro.props;
const src = variant === 'mark' ? logoMark : variant === 'wordmark' ? logoWordmark : logoFull;
const width = Math.round((height * src.width) / src.height);
---

<span class:list={['logo', `logo--${variant}`, { 'logo--invert': invert }, Astro.props.class]} style={`--logo-h: ${height}px`}>
  <Image
    src={src}
    alt={site.name}
    width={width}
    height={height}
    densities={[1, 2, 3]}
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo img {
    height: var(--logo-h, 32px);
    width: auto;
    max-width: none;
  }
  .logo--invert img {
    filter: brightness(0) invert(1);
  }
</style>
