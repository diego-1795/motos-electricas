---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
}
const { eyebrow, title, text, as: Tag = 'h2', align = 'left' } = Astro.props;
---

<header class:list={['sh', { 'sh--center': align === 'center' }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag>{title}</Tag>
  {text && <p class="muted sh__text">{text}</p>}
  <slot />
</header>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-8);
  }
  .sh--center {
    align-items: center;
    text-align: center;
  }
  .sh__text {
    font-size: var(--fs-lg);
    max-width: 56ch;
  }
</style>
