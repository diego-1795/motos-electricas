---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppLink from '../components/ui/WhatsAppLink.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o ha cambiado de dirección." path="/404" noindex>
  <div class="container section nf">
    <p class="eyebrow">Error 404</p>
    <h1>Esta ruta no lleva a ningún sitio</h1>
    <p class="muted nf__text">La página que buscas no existe o ha cambiado de dirección. Pero el catálogo sigue ahí, cargado al 100 %.</p>
    <div class="nf__actions">
      <a href="/motos-electricas" class="btn btn--primary btn--lg">Ver el catálogo</a>
      <a href="/encuentra-tu-moto" class="btn btn--secondary btn--lg">Encuentra tu moto</a>
      <WhatsAppLink source="product" class="btn btn--ghost btn--lg">Preguntar por WhatsApp</WhatsAppLink>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-4);
    max-width: var(--container-narrow);
  }
  .nf h1 {
    font-size: var(--fs-3xl);
    font-weight: 700;
  }
  .nf__text {
    font-size: var(--fs-lg);
  }
  .nf__actions {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
</style>
