---
import Pic from '../../components/ui/Pic.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import QuickAdd from '../../islands/QuickAdd';
import { repos } from '../../data';
import { formatMoney } from '../../domain/money';
import { availabilityLabel } from '../../domain/product';
import { publicSrc } from '../../lib/images';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo/jsonld';

const accessories = await repos.accessories.all();
const kinds: Record<string, string> = { bateria: 'Baterías', casco: 'Cascos', baul: 'Baúles', cargador: 'Cargadores', seguridad: 'Seguridad', otro: 'Otros' };
const groups = Object.entries(kinds)
  .map(([k, label]) => ({ label, items: accessories.filter((a) => a.kind === k) }))
  .filter((g) => g.items.length);
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Accesorios', url: '/accesorios' },
];
---

<BaseLayout
  title="Accesorios para motos eléctricas"
  description="Baterías adicionales, cascos, baúles, cargadores rápidos y seguridad para tu moto eléctrica. Añádelos a tu solicitud de compra."
  path="/accesorios"
  jsonLd={[breadcrumbSchema(crumbs), itemListSchema(accessories.map((a) => ({ name: a.name, url: `/accesorios/${a.slug}` })))]}
>
  <div class="container section">
    <Breadcrumbs items={crumbs} />
    <SectionHeading as="h1" title="Accesorios" text="Amplía autonomía, protégete y equipa tu vehículo. Todo compatible y verificado." />
    {
      groups.map((g) => (
        <section class="acc__group" aria-labelledby={`g-${g.label}`}>
          <h2 id={`g-${g.label}`}>{g.label}</h2>
          <ul role="list" class="grid-products">
            {g.items.map((a) => (
              <li class="card acc__card">
                <a href={`/accesorios/${a.slug}`} class="acc__media" tabindex="-1" aria-hidden="true">
                  {a.image && <Pic image={a.image} alt="" width={480} height={480} widths={[320, 480]} sizes="(min-width:768px) 22vw, 45vw" />}
                </a>
                <div class="acc__body">
                  <h3>
                    <a href={`/accesorios/${a.slug}`}>{a.name}</a>
                  </h3>
                  <p class="muted acc__desc">{a.description}</p>
                  <div class="acc__foot">
                    <strong>{formatMoney(a.price)}</strong>
                    <span class="badge">{availabilityLabel[a.availability]}</span>
                  </div>
                  <QuickAdd client:visible kind="accessory" slug={a.slug} name={a.name} unitPrice={a.price} image={a.image ? { ...a.image, src: publicSrc(a.image) } : undefined} disabled={a.availability === 'agotado'} />
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .acc__group {
    margin-top: var(--s-10);
  }
  .acc__group h2 {
    font-size: var(--fs-xl);
    margin-bottom: var(--s-4);
  }
  .acc__media {
    display: block;
    aspect-ratio: 1;
    background: var(--n-950);
  }
  .acc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .acc__body {
    padding: var(--s-4) var(--s-5) var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .acc__body h3 {
    font-size: var(--fs-md);
  }
  .acc__desc {
    font-size: var(--fs-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .acc__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--s-1);
  }
</style>
