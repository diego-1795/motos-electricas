---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { repos } from '../../data';
import type { BlogPost } from '../../domain/types';
import { site } from '../../config/site';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo/jsonld';

const posts = await repos.blog.all();
const categoryLabel: Record<BlogPost['category'], string> = {
  guias: 'Guías',
  comparativas: 'Comparativas',
  autonomia: 'Autonomía',
  baterias: 'Baterías',
  mantenimiento: 'Mantenimiento',
  legislacion: 'Legislación',
  movilidad: 'Movilidad eléctrica',
  compra: 'Consejos de compra',
};
const fmtDate = new Intl.DateTimeFormat(site.locale, { day: 'numeric', month: 'long', year: 'numeric' });
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog' },
];
---

<BaseLayout
  title="Blog: guías sobre motos eléctricas"
  description="Guías, comparativas y consejos sobre autonomía, baterías, licencias y mantenimiento de motos y scooters eléctricos."
  path="/blog"
  jsonLd={[breadcrumbSchema(crumbs), itemListSchema(posts.map((p) => ({ name: p.title, url: `/blog/${p.slug}` })))]}
>
  <div class="container section">
    <Breadcrumbs items={crumbs} />
    <SectionHeading as="h1" eyebrow="Blog" title="Guías y consejos" text="Todo lo que necesitas saber antes y después de pasarte a la movilidad eléctrica." />
    <ul role="list" class="blog__grid">
      {
        posts.map((p) => (
          <li class="card card--interactive blog__card">
            <article>
              <p class="eyebrow">{categoryLabel[p.category]}</p>
              <h2>
                <a href={`/blog/${p.slug}`}>{p.title}</a>
              </h2>
              <p class="muted blog__desc">{p.description}</p>
              <p class="muted blog__meta">
                <time datetime={p.publishedAt}>{fmtDate.format(new Date(p.publishedAt))}</time> · {p.readingMinutes} min de lectura
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .blog__grid {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .blog__card {
    padding: var(--s-6);
  }
  .blog__card article {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
  }
  .blog__card h2 {
    font-size: var(--fs-xl);
  }
  .blog__card h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .blog__card {
    position: relative;
  }
  .blog__desc {
    font-size: var(--fs-sm);
    flex: 1;
  }
  .blog__meta {
    font-size: var(--fs-xs);
  }
  @media (min-width: 768px) {
    .blog__grid {
      gap: var(--s-6);
    }
  }
</style>
