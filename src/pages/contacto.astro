---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import WhatsAppLink from '../components/ui/WhatsAppLink.astro';
import ContactForm from '../islands/ContactForm';
import { site } from '../config/site';
import { breadcrumbSchema } from '../lib/seo/jsonld';

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
];
const socials = [
  { name: 'Instagram', url: site.social.instagram },
  { name: 'Facebook', url: site.social.facebook },
  { name: 'TikTok', url: site.social.tiktok },
].filter((s) => s.url);
---

<BaseLayout
  title="Contacto"
  description={`Escríbenos por WhatsApp (${site.phoneDisplay}) o correo. Oficina en ${site.address}. ${site.hours}. Asesoría sobre bicimotos, repuestos y servicio técnico RAIDEN.`}
  path="/contacto"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <div class="container section">
    <Breadcrumbs items={crumbs} />
    <SectionHeading as="h1" eyebrow="Contacto" title="Hablemos" text="Escríbenos y te atiende una persona del equipo. El formulario abre WhatsApp o tu correo con el mensaje listo: nada se guarda en esta web." />

    <div class="contact">
      <section class="card contact__form" aria-labelledby="form-h">
        <h2 id="form-h">Envíanos un mensaje</h2>
        <ContactForm client:visible />
      </section>

      <aside class="contact__info">
        <section class="card contact__card contact__card--wa" aria-labelledby="wa-h">
          <p class="eyebrow">Canal principal</p>
          <h2 id="wa-h">WhatsApp</h2>
          <p class="contact__big"><a href={`tel:+${site.whatsappNumber}`}>{site.phoneDisplay}</a></p>
          <p class="muted">Asesoría, cotizaciones y solicitudes de compra con envío a todo el Perú.</p>
          <WhatsAppLink source="contact" class="btn btn--whatsapp">Abrir WhatsApp</WhatsAppLink>
        </section>

        <section class="card contact__card" aria-labelledby="mail-h">
          <p class="eyebrow">Correo</p>
          <h2 id="mail-h">Escríbenos</h2>
          <p><a href={`mailto:${site.contactEmail}`} class="contact__link">{site.contactEmail}</a></p>
          <p class="muted">Para garantías, documentación o consultas con adjuntos.</p>
        </section>

        <section class="card contact__card" aria-labelledby="hours-h">
          <p class="eyebrow">Horario de atención</p>
          <h2 id="hours-h">Atención</h2>
          <p class="contact__hours">{site.hours}</p>
          <p class="muted contact__note">Horario de Lima (GMT-5). Los mensajes fuera de horario se responden al día siguiente.</p>
        </section>

        <section class="card contact__card" aria-labelledby="addr-h">
          <p class="eyebrow">Oficina principal</p>
          <h2 id="addr-h">Visítanos</h2>
          <address class="contact__address">
            <p>{site.address}</p>
            <p class="muted">{site.legalName} · RUC {site.ruc}</p>
          </address>
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21z" />
              <circle cx="12" cy="9.5" r="2.5" />
            </svg>
            Ver en Google Maps
          </a>
        </section>

        <section class="card contact__card" aria-labelledby="social-h">
          <p class="eyebrow">Redes</p>
          <h2 id="social-h">Síguenos</h2>
          <ul role="list" class="contact__social">
            {
              socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>

    <p class="muted contact__disclaimer">
      No se realizan pagos online. Toda compra se gestiona como solicitud por WhatsApp y se confirma con nuestro equipo antes de cualquier pago. Enviamos a Lima, Callao y todo el Perú vía courier o agencia.
    </p>
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--s-6);
  }
  .contact__form {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .contact__form h2 {
    font-size: var(--fs-xl);
  }
  .contact__info {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .contact__card {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .contact__card h2 {
    font-size: var(--fs-lg);
  }
  .contact__card .btn {
    align-self: flex-start;
    margin-top: var(--s-1);
  }
  .contact__big {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
  .contact__link {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    word-break: break-all;
  }
  .contact__hours {
    font-weight: 600;
  }
  .contact__note {
    font-size: var(--fs-sm);
  }
  .contact__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .contact__social {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .contact__social a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact__social a:hover {
    color: var(--accent-text, var(--accent));
  }
  .contact__disclaimer {
    margin-top: var(--s-8);
    font-size: var(--fs-sm);
    max-width: var(--container-narrow);
  }
  @media (min-width: 768px) {
    .contact__info {
      grid-template-columns: 1fr 1fr;
    }
    .contact__card--wa {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-10);
      align-items: start;
    }
    .contact__form {
      padding: var(--s-8);
    }
    .contact__info {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* Isla ContactForm.tsx (estilos aquí: src/styles/** pertenece al Design System) */
  .cf {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .cf__row {
    display: grid;
    gap: var(--s-4);
  }
  .cf__err {
    font-size: var(--fs-xs);
    color: var(--danger);
    font-weight: 600;
  }
  .cf [aria-invalid='true'] {
    border-color: var(--danger);
  }
  .cf__actions {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-2);
  }
  @media (min-width: 640px) {
    .cf__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
