---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BikeFinder from '../islands/BikeFinder';
import { repos } from '../data';
import { publicSrc } from '../lib/images';
import { breadcrumbSchema } from '../lib/seo/jsonld';
import type { Product } from '../domain/types';

const all = (await repos.products.all()).filter((p) => p.category !== 'accesorios');
// Reducimos el payload: la isla solo necesita lo que usa el motor de recomendación y la tarjeta.
const products = all.map(
  (p): Product => ({
    ...p,
    images: [],
    technology: [],
    faqs: [],
    reviews: [],
    description: '',
    claim: '',
    highlights: [],
    accessories: [],
    related: [],
  }),
);
const images = Object.fromEntries(all.map((p) => [p.slug, publicSrc(p.images[0]!)]));
const categoryNames = Object.fromEntries((await repos.categories.all()).map((c) => [c.slug, c.name]));
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Encuentra tu moto', url: '/encuentra-tu-moto' },
];
---

<BaseLayout
  title="Encuentra tu moto eléctrica ideal"
  description="Responde tres preguntas sobre uso, presupuesto y autonomía y te recomendamos las motos eléctricas que mejor encajan contigo."
  path="/encuentra-tu-moto"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <div class="container container--narrow section">
    <Breadcrumbs items={crumbs} />
    <SectionHeading as="h1" eyebrow="Asistente" title="Encuentra tu moto" text="Tres preguntas. Sin registro. Te mostramos los modelos ordenados por compatibilidad." />
    <BikeFinder client:load products={products} images={images} categoryNames={categoryNames} />
  </div>
</BaseLayout>
