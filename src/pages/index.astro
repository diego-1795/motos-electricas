---
import Pic from '../components/ui/Pic.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product/ProductCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import WhatsAppLink from '../components/ui/WhatsAppLink.astro';
import { repos } from '../data';
import { site } from '../config/site';
import { effectiveSpecs, fromPrice, kw, maxRange } from '../domain/product';
import { formatMoney } from '../domain/money';
import { publicSrc } from '../lib/images';

const hero = (await repos.products.hero())!;
const featured = (await repos.products.featured(6)).filter((p) => p.slug !== hero.slug).slice(0, 3);
const categories = await repos.categories.all();
const posts = (await repos.blog.all()).slice(0, 3);
const heroSpecs = effectiveSpecs(hero);
const heroImg = hero.images[0]!;

const steps = [
  { n: '01', t: 'Descubre', d: 'Explora el catálogo o deja que "Encuentra tu moto" te recomiende el modelo ideal.' },
  { n: '02', t: 'Compara y configura', d: 'Hasta 3 modelos lado a lado. Elige batería, color y accesorios.' },
  { n: '03', t: 'Solicita por WhatsApp', d: 'Tu carrito se convierte en un mensaje. Un asesor confirma disponibilidad y condiciones.' },
];
---

<BaseLayout
  title={`${site.name} — Motos eléctricas, scooters y movilidad eléctrica`}
  description={site.description}
  path="/"
  image={publicSrc(heroImg)}
  dark
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">{hero.subtitle}</p>
        <h1 class="hero__title">{hero.name}</h1>
        <p class="hero__claim">{hero.claim}</p>
        <dl class="hero__specs">
          <div><dt>Autonomía</dt><dd>{maxRange(hero)} km</dd></div>
          <div><dt>Velocidad</dt><dd>{heroSpecs.topSpeedKmh} km/h</dd></div>
          <div><dt>Potencia</dt><dd>{kw(heroSpecs.powerW)}</dd></div>
          <div><dt>Desde</dt><dd>{formatMoney(fromPrice(hero))}</dd></div>
        </dl>
        <div class="hero__cta">
          <a href={`/motos-electricas/${hero.slug}`} class="btn btn--primary btn--lg">Descubrir modelo</a>
          <a href="/encuentra-tu-moto" class="btn btn--secondary btn--lg">Encontrar mi moto</a>
        </div>
      </div>
      <div class="hero__media">
        <Pic image={heroImg} width={1200} height={750} widths={[640, 960, 1200, 1600]} sizes="(min-width: 1024px) 58vw, 100vw" priority />
      </div>
    </div>
  </section>

  <!-- CATEGORÍAS (editorial) -->
  <section class="section cats">
    <div class="container">
      <SectionHeading eyebrow="Showroom" title="Elige tu tipo de vehículo" text="Una gama pensada para ciudad, trabajo, reparto y ocio. Sin ruido, sin gasolina." />
      <ul role="list" class="cats__list">
        {
          categories.map((c, i) => (
            <li class:list={['cats__item', { 'cats__item--wide': i === 0 }]}>
              <a href={`/${c.slug}`} class="cats__link">
                {c.image && (
                  <Pic image={c.image} alt="" width={800} height={533} widths={[480, 800]} sizes="(min-width: 768px) 45vw, 92vw" />
                )}
                <span class="cats__text">
                  <span class="cats__name">{c.name}</span>
                  <span class="cats__tag">{c.tagline}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="section featured">
    <div class="container">
      <SectionHeading eyebrow="Modelos destacados" title="Los más solicitados" />
      <div class="grid-products">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <p class="featured__more">
        <a href="/motos-electricas" class="btn btn--secondary">Ver todo el catálogo</a>
      </p>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="section how">
    <div class="container">
      <SectionHeading eyebrow="Cómo funciona" title="De la idea a la moto en tres pasos" text="Sin pagos online ni formularios interminables. Configuras, solicitas y hablas con una persona." />
      <ol role="list" class="how__steps">
        {
          steps.map((s) => (
            <li class="how__step">
              <span class="how__n">{s.n}</span>
              <h3>{s.t}</h3>
              <p class="muted">{s.d}</p>
            </li>
          ))
        }
      </ol>
      <div class="how__cta">
        <WhatsAppLink source="header" class="btn btn--whatsapp btn--lg">Hablar con un asesor</WhatsAppLink>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {
    posts.length > 0 && (
      <section class="section blog">
        <div class="container">
          <SectionHeading eyebrow="Guías" title="Aprende antes de decidir" />
          <ul role="list" class="blog__list">
            {posts.map((post) => (
              <li class="card blog__card">
                <a href={`/blog/${post.slug}`}>
                  <p class="eyebrow">{post.category}</p>
                  <h3>{post.title}</h3>
                  <p class="muted">{post.description}</p>
                  <small class="muted">{post.readingMinutes} min de lectura</small>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-10) var(--s-16);
    background:
      radial-gradient(60% 50% at 70% 40%, rgb(214 255 63 / 0.08), transparent 70%),
      var(--dark-bg);
  }
  .hero__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    order: 2;
  }
  .hero__eyebrow {
    color: var(--volt);
  }
  .hero__title {
    font-size: var(--fs-4xl);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .hero__claim {
    font-size: var(--fs-xl);
    color: var(--dark-fg-muted);
    max-width: 40ch;
  }
  .hero__specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--dark-border);
  }
  .hero__specs dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--dark-fg-muted);
  }
  .hero__specs dd {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .hero__media {
    order: 1;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--dark-bg-elev);
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--s-16) var(--s-24);
    }
    .hero__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-12);
    }
    .hero__copy {
      order: 1;
    }
    .hero__media {
      order: 2;
    }
    .hero__specs {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cats__list {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: 1fr;
  }
  .cats__link {
    position: relative;
    display: block;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--dark-bg-elev);
    aspect-ratio: 3 / 2;
    border: 1px solid var(--dark-border);
    transition: border-color var(--t-base) var(--ease);
  }
  .cats__link:hover {
    text-decoration: none;
    border-color: var(--n-600);
  }
  .cats__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }
  .cats__text {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    background: linear-gradient(to top, rgb(11 12 15 / 0.9), transparent);
  }
  .cats__name {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
  .cats__tag {
    font-size: var(--fs-sm);
    color: var(--dark-fg-muted);
  }
  @media (min-width: 768px) {
    .cats__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .cats__item--wide {
      grid-column: span 2;
    }
    .cats__item--wide .cats__link {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .featured__more {
    margin-top: var(--s-8);
    text-align: center;
  }

  .how__steps {
    display: grid;
    gap: var(--s-6);
  }
  .how__step {
    padding: var(--s-6);
    border: 1px solid var(--dark-border);
    border-radius: var(--r-xl);
    background: var(--dark-bg-elev);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .how__n {
    font-family: var(--font-mono);
    color: var(--volt);
    font-size: var(--fs-sm);
  }
  .how__cta {
    margin-top: var(--s-8);
  }
  @media (min-width: 768px) {
    .how__steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog__list {
    display: grid;
    gap: var(--s-4);
  }
  .blog__card a {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-6);
    height: 100%;
  }
  .blog__card a:hover {
    text-decoration: none;
  }
  .blog__card h3 {
    font-size: var(--fs-lg);
  }
  @media (min-width: 768px) {
    .blog__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
