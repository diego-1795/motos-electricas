---
import Pic from '../components/ui/Pic.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import PreloadImage from '../components/ui/PreloadImage.astro';
import ProductCard from '../components/product/ProductCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import WhatsAppLink from '../components/ui/WhatsAppLink.astro';
import { repos } from '../data';
import { site } from '../config/site';
import { publicSrc } from '../lib/images';
import { ALL_PRODUCTS_PATH, PARTS_PATH } from '../lib/routes';
import { SUPPORT_MESSAGE } from '../services/whatsapp/WhatsAppMessageBuilder';
import { blogCategoryLabel } from '../lib/labels';
import { averageRating, pickTestimonials } from '../domain/testimonials';
import type { ImageRef } from '../domain/types';

const products = (await repos.products.all()).filter((p) => p.category !== 'repuestos');
const hero = products.find((p) => p.isHero) ?? products[0]!;
/* Primera diapositiva del hero (misma lógica que HeroSlider: productos con heroImage) */
const firstSlide = products.find((p) => p.heroImage);
const recent = [...products].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt) || b.featured - a.featured).slice(0, 4);
const categories = await repos.categories.all();
const categoryNames = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const posts = (await repos.blog.all()).slice(0, 3);
const fmtDate = new Intl.DateTimeFormat(site.locale, { day: 'numeric', month: 'short' });

/* Galería de clientes (fotos del cliente, 960x1280) */
const raiders: ImageRef[] = Array.from({ length: 9 }, (_, i) => ({
  src: `~/assets/clientes/raider-${i + 1}.jpg`,
  alt: 'Cliente RAIDEN con su bicimoto',
  width: 960,
  height: 1280,
}));

/* Testimonios: reseñas públicas reales (src/content/testimonials, hoy Google Maps).
   Se destacan las 3 mejor valoradas que más cuentan; nunca textos inventados. */
const allReviews = await repos.testimonials.all();
const testimonials = pickTestimonials(allReviews, 3);
const reviewsAvg = averageRating(allReviews);

const serviceImg: ImageRef = { src: '~/assets/hero/servicio-tecnico.jpg', alt: 'Técnico RAIDEN revisando una bicimoto eléctrica', width: 1614, height: 640 };
const catIcons: Record<string, string> = {
  bicimotos: 'M5 17a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm14 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM5 14l4-7h4l3 7M9 7h5l2 3',
  trimotos: 'M3 17h2m14 0h2M5 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0zm10 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0zM7 17V9h8l3 5v3M3 9h4',
  repuestos: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.4 2.4-2-2z',
};
---

<BaseLayout
  title={`${site.name} — Bicimotos y trimotos eléctricas en Perú. ${site.tagline}`}
  description={site.description}
  path="/"
  image={hero.heroImage ? publicSrc(hero.heroImage) : publicSrc(hero.images[0]!)}
>
  {firstSlide?.heroImage && <PreloadImage slot="head" image={firstSlide.heroImage} widths={[480, 720, 960, 1280, 1600]} sizes="100vw" />}
  <!-- 1. HERO: DESCUBRE TU INSTINTO -->
  <HeroSlider products={products} />

  <!-- 1b. CATEGORÍAS (3 tiles compactos) -->
  <section class="section cats" aria-label="Categorías">
    <div class="container">
      <ul role="list" class="cats__row">
        {
          categories.map((c) => (
            <li>
              <a href={`/${c.slug}`} class="cats__tile">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={catIcons[c.slug]} />
                </svg>
                <span class="cats__name">{c.name}</span>
                <span class="cats__tag muted">{c.tagline}</span>
                <span class="cats__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2. PRODUCTOS RECIENTES -->
  <section class="section recent" aria-labelledby="recent-h">
    <div class="container">
      <SectionHeading eyebrow="Productos recientes" title="Descubre tu instinto RAIDEN" text="Bicimotos de 25 km/h sin licencia y una trimoto de carga. Versiones Estándar y Premium, garantía de 12 meses en batería y motor." />
      <div class="grid-products recent__grid">
        {recent.map((p) => <ProductCard product={p} categoryLabel={categoryNames[p.category]} />)}
      </div>
      <p class="recent__more">
        <a href={ALL_PRODUCTS_PATH} class="btn btn--secondary">Ver todos los productos</a>
        <a href={PARTS_PATH} class="btn btn--ghost">Repuestos →</a>
      </p>
    </div>
  </section>

  <!-- 3. RAIDERS SATISFECHOS -->
  <section class="section raiders surface-dark" aria-labelledby="raiders-h">
    <div class="container">
      <SectionHeading eyebrow="Raiders satisfechos" title="Somos parte de cada momento, de cada historia" align="center" />
      <ul role="list" class="raiders__masonry">
        {
          raiders.map((img) => (
            <li>
              <Pic image={img} width={480} height={640} widths={[320, 480, 640]} sizes="(min-width: 1024px) 30vw, (min-width: 480px) 45vw, 92vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. COMUNIDAD RAIDEN -->
  <section class="section community" aria-labelledby="community-h">
    <div class="container">
      <SectionHeading eyebrow="Comunidad RAIDEN" title="Nuestros Raiders nos recomiendan" align="center" />
      {
        testimonials.length > 0 && (
          <ul role="list" class="community__list">
            {testimonials.map((t) => (
              <li class="community__card">
                <p class="community__stars" aria-label={`${t.rating} de 5 estrellas`}>
                  {'★★★★★'.slice(0, t.rating)}
                </p>
                <blockquote>
                  <p>“{t.text}”</p>
                </blockquote>
                <footer class="muted">
                  <strong>{t.author}</strong> · Reseña en Google
                </footer>
              </li>
            ))}
          </ul>
        )
      }
      <p class="community__more">
        {reviewsAvg !== undefined && (
          <span class="community__avg">
            <span class="community__stars" aria-hidden="true">
              ★
            </span>
            <strong>{reviewsAvg.toLocaleString(site.locale, { minimumFractionDigits: 1 })}</strong> de 5 en Google ({allReviews.length} reseñas)
          </span>
        )}
        <a href={site.mapsUrl} class="btn btn--ghost" rel="noopener" target="_blank">
          Ver todas las reseñas en Google →
        </a>
      </p>
    </div>
  </section>

  <!-- 5. SERVICIO TÉCNICO -->
  <section class="section service surface-dark" aria-labelledby="service-h">
    <div class="container">
      <div class="service__banner">
        <div class="service__media">
          <Pic image={serviceImg} alt="" width={1200} height={476} widths={[640, 960, 1200]} sizes="(min-width: 1024px) 60vw, 100vw" />
        </div>
        <div class="service__copy">
          <p class="eyebrow service__eyebrow">Servicio técnico</p>
          <h2 id="service-h">Tu bicimoto, siempre a punto</h2>
          <p class="muted">Diagnóstico y mantenimiento preventivo de sistema eléctrico, motor, batería, frenos y controlador, con repuestos originales y atención especializada en Callao.</p>
          <div class="service__cta">
            <a href="/servicio-tecnico" class="btn btn--primary">Conocer el servicio</a>
            <WhatsAppLink source="support" class="btn btn--whatsapp" message={SUPPORT_MESSAGE}>Solicitar soporte</WhatsAppLink>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. BLOG -->
  {
    posts.length > 0 && (
      <section class="section blog" aria-labelledby="blog-h">
        <div class="container">
          <div class="blog__head">
            <SectionHeading eyebrow="Blog" title="Aprende antes de decidir" />
            <a href="/blog" class="btn btn--ghost">Todos los artículos →</a>
          </div>
          <ul role="list" class="blog__list">
            {posts.map((post) => (
              <li class="card blog__card">
                <a href={`/blog/${post.slug}`}>
                  {post.image && <Pic image={post.image} alt="" width={640} height={400} widths={[400, 640]} sizes="(min-width: 768px) 30vw, 92vw" class="blog__img" />}
                  <span class="blog__body">
                    <span class="eyebrow">{blogCategoryLabel[post.category]}</span>
                    <h3>{post.title}</h3>
                    <span class="muted blog__desc">{post.description}</span>
                    <small class="muted">
                      <time datetime={post.publishedAt}>{fmtDate.format(new Date(post.publishedAt))}</time> · {post.readingMinutes} min de lectura
                    </small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Categorías */
  .cats {
    padding-block: var(--s-10);
  }
  .cats__row {
    display: grid;
    gap: var(--s-4);
  }
  .cats__tile {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'icon name arrow'
      'icon tag arrow';
    column-gap: var(--s-4);
    align-items: center;
    padding: var(--s-5) var(--s-6);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--bg-elev);
    transition:
      border-color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }
  .cats__tile:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .cats__tile svg {
    grid-area: icon;
    color: var(--accent-text, var(--accent));
  }
  .cats__name {
    grid-area: name;
    font-family: var(--font-display, var(--font-sans));
    font-size: var(--fs-lg);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .cats__tag {
    grid-area: tag;
    font-size: var(--fs-sm);
  }
  .cats__arrow {
    grid-area: arrow;
    color: var(--fg-muted);
  }
  @media (min-width: 768px) {
    .cats__row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Recientes */
  .recent__grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .recent__more {
    margin-top: var(--s-8);
    display: flex;
    gap: var(--s-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Raiders */
  .raiders__masonry {
    columns: 2;
    column-gap: var(--s-3);
  }
  .raiders__masonry li {
    break-inside: avoid;
    margin-bottom: var(--s-3);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-elev);
  }
  .raiders__masonry li:nth-child(3n + 2) {
    border-radius: var(--r-xl);
  }
  .raiders__masonry :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--t-slow) var(--ease);
  }
  @media (hover: hover) {
    .raiders__masonry li:hover :global(img) {
      transform: scale(1.02);
    }
  }
  @media (min-width: 768px) {
    .raiders__masonry {
      columns: 3;
      column-gap: var(--s-4);
    }
    .raiders__masonry li {
      margin-bottom: var(--s-4);
    }
  }

  /* Comunidad */
  .community__list {
    display: grid;
    gap: var(--s-4);
  }
  .community__card {
    padding: var(--s-6);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .community__stars {
    color: var(--accent-text, var(--accent));
    letter-spacing: 0.15em;
    font-size: var(--fs-sm);
  }
  .community__card blockquote p {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
  }
  .community__card footer {
    font-size: var(--fs-sm);
    margin-top: auto;
  }
  .community__card footer strong {
    color: var(--fg);
  }
  .community__more {
    margin-top: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .community__avg {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .community__avg strong {
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .community__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-6);
    }
  }

  /* Servicio técnico */
  .service__banner {
    display: grid;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .service__media {
    aspect-ratio: 16 / 9;
    background: var(--bg-sunken);
  }
  .service__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service__copy {
    padding: var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    justify-content: center;
  }
  .service__eyebrow {
    color: var(--accent-text, var(--accent));
  }
  .service__cta {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-2);
  }
  @media (min-width: 1024px) {
    .service__banner {
      grid-template-columns: 3fr 2fr;
    }
    .service__media {
      aspect-ratio: auto;
      min-height: 22rem;
    }
    .service__copy {
      padding: var(--s-12);
    }
  }

  /* Blog */
  .blog__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .blog__list {
    display: grid;
    gap: var(--s-4);
  }
  .blog__card a {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .blog__card a:hover {
    text-decoration: none;
  }
  .blog__card :global(.blog__img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--bg-sunken);
  }
  .blog__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-6);
  }
  .blog__card h3 {
    font-size: var(--fs-lg);
  }
  .blog__desc {
    font-size: var(--fs-sm);
  }
  @media (min-width: 768px) {
    .blog__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-6);
    }
  }
</style>
