---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogView from '../components/catalog/CatalogView.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { repos } from '../data';
import { breadcrumbSchema, faqSchema, itemListSchema } from '../lib/seo/jsonld';
import { applyFilters, sortProducts } from '../domain/catalog';

/**
 * Página SEO útil (no duplicado): selección curada de modelos para ciudad
 * con contenido propio de orientación. Solo los modelos con useCase "ciudad".
 */
const all = await repos.products.all();
const products = sortProducts(applyFilters(all, { useCase: 'ciudad' }), 'recomendados');
const categories = await repos.categories.all();
const categoryNames = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Motos eléctricas urbanas', url: '/motos-electricas-urbanas' },
];
const faqs = [
  {
    question: '¿Qué autonomía necesito para moverme por ciudad?',
    answer:
      'La mayoría de desplazamientos urbanos diarios están entre 10 y 30 km. Un modelo con 60-80 km de autonomía real permite cargar solo 2-3 veces por semana.',
  },
  {
    question: '¿Puedo cargar la batería en casa?',
    answer: 'Sí. Muchos modelos tienen batería extraíble para cargar en cualquier enchufe doméstico en 4-6 horas. Las no extraíbles se cargan en garaje o plaza con toma.',
  },
  {
    question: '¿Necesito licencia para una moto eléctrica urbana?',
    answer:
      'Depende del vehículo: las bicimotos de baja velocidad no requieren licencia; las motos eléctricas matriculables requieren licencia de la clase B (B-IIa, B-IIb o B-IIc según el modelo), placa y SOAT. Te lo confirmamos por WhatsApp para tu modelo y ciudad.',
  },
];
---

<BaseLayout
  title="Motos eléctricas urbanas: las mejores para ciudad"
  description="Selección de motos y scooters eléctricos para ciudad: ágiles, silenciosos y con batería extraíble. Autonomía real, licencia necesaria y precios en soles desde S/ 2,490."
  path="/motos-electricas-urbanas"
  jsonLd={[breadcrumbSchema(crumbs), itemListSchema(products.map((p) => ({ name: p.name, url: `/motos-electricas/${p.slug}` }))), faqSchema(faqs)]}
>
  <div class="container section">
    <Breadcrumbs items={crumbs} />
    <SectionHeading
      as="h1"
      eyebrow="Selección"
      title="Motos eléctricas urbanas"
      text="Modelos pensados para el día a día: aparcas en cualquier sitio, cargas en casa y no pagas gasolina. Aquí están los que mejor funcionan en ciudad."
    />
    <CatalogView products={products} categoryNames={categoryNames} />

    <section class="guide prose">
      <h2>Cómo elegir una moto eléctrica para ciudad</h2>
      <p>
        En ciudad importan tres cosas: <strong>autonomía real</strong> suficiente para dos o tres días sin cargar, <strong>batería extraíble</strong> si no tienes
        garaje, y un <strong>tamaño</strong> que te permita moverte entre el tráfico y aparcar sin esfuerzo. La velocidad máxima importa menos de lo que parece:
        45 km/h es suficiente en la mayoría de vías urbanas; 80 km/h te permite usar rondas y circunvalaciones.
      </p>
      <h2>Preguntas frecuentes</h2>
      {
        faqs.map((f) => (
          <details class="accordion">
            <summary>{f.question}</summary>
            <div>{f.answer}</div>
          </details>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .guide {
    margin-top: var(--s-16);
  }
</style>
