---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/catalog/CatalogView.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { repos } from '../../data';
import { breadcrumbSchema, itemListSchema } from '../../lib/seo/jsonld';

const products = (await repos.products.all()).filter((p) => p.category !== 'accesorios');
const categories = await repos.categories.all();
const categoryNames = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Motos eléctricas', url: '/motos-electricas' },
];
---

<BaseLayout
  title="Motos eléctricas y scooters: catálogo completo"
  description="Catálogo de motos eléctricas, scooters, bicimotos, trimotos y vehículos de carga. Filtra por precio, autonomía, velocidad y potencia. Solicita tu compra por WhatsApp."
  path="/motos-electricas"
  jsonLd={[breadcrumbSchema(crumbs), itemListSchema(products.map((p) => ({ name: p.name, url: `/motos-electricas/${p.slug}` })))]}
>
  <div class="container section">
    <Breadcrumbs items={crumbs} />
    <SectionHeading as="h1" title="Catálogo de vehículos eléctricos" text="Todos nuestros modelos. Filtra por lo que te importa y compara hasta tres." />
    <CatalogView products={products} categoryNames={categoryNames} />
  </div>
</BaseLayout>
