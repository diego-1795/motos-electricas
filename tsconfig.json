{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noUncheckedIndexedAccess": true
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "functions",
    "tests/unit/admin-access.test.ts",
    "tests/unit/admin-github.test.ts",
    "tests/unit/admin-handlers.test.ts",
    "tests/unit/admin-http.test.ts"
  ]
}
